{
  "name": "composed-build-kit",
  "version": "0.7.0",
  "description": "Portable, agent-agnostic kit for governed multi-agent software delivery.",
  "type": "module",
  "private": true,
  "bin": {
    "composed-kit": "./bin/composed-kit.mjs",
    "hunch-init": "./bin/composed-kit.mjs"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "test:watch": "vitest",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --noEmit",
    "validate:agentic": "node evals/validate-catalog.mjs",
    "eval:fixture": "node evals/run.mjs --adapter fixture --output evals/runs/fixture",
    "eval:evidence": "node evals/evidence-example.mjs",
    "benchmark:calibrate": "node benchmarks/calibrate.mjs",
    "benchmark:run": "node benchmarks/run.mjs",
    "benchmark:report": "node benchmarks/report.mjs",
    "release:check": "node scripts/check-package.mjs",
    "example:product": "node examples/product-loop/verify.mjs",
    "example:quality": "node examples/engineering-quality/verify.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.9",
    "vite": "^6.4.4"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yassmii/composed.git",
    "directory": "build-kit"
  },
  "license": "MIT"
}
