{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "research_status", "candidate_products", "source_selection", "sources"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "research_status": {"enum": ["not_started", "initial", "reviewed"]},
    "candidate_products": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "source_selection": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "sources": {"type": "array", "items": {"$ref": "#/$defs/source"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "product", "version", "title", "url", "locator", "retrieved_on", "content_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"},
        "product": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri"},
        "locator": {"type": "string", "minLength": 1},
        "retrieved_on": {"type": "string", "format": "date"},
        "content_normalization": {"enum": ["cloudflare_ephemera", "html_article_text"]},
        "content_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      }
    }
  }
}
