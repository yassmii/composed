{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://composed-contract.org/schemas/clause-correspondence/1.json",
  "title": "Explicit clause correspondence declarations",
  "type": "object",
  "additionalProperties": false,
  "required": ["format_version", "kind", "before", "after", "links"],
  "properties": {
    "format_version": { "const": 1 },
    "kind": { "const": "clause-correspondence" },
    "before": { "$ref": "#/$defs/pin" },
    "after": { "$ref": "#/$defs/pin" },
    "links": {
      "type": "array",
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "relation", "status", "reason"],
        "properties": {
          "from": { "$ref": "#/$defs/ids" },
          "to": { "$ref": "#/$defs/ids" },
          "relation": { "enum": ["renamed", "split", "merged"] },
          "status": { "enum": ["proposed", "accepted", "rejected"] },
          "reason": { "type": "string", "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  },
  "$defs": {
    "ids": {
      "type": "array", "minItems": 1, "maxItems": 4096, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*[A-Z0-9]$" }
    },
    "pin": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "sha256"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
        "version": { "type": "string", "minLength": 1, "maxLength": 256 },
        "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    }
  }
}
