{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "observations"],
  "properties": {
    "schema_version": {"const": "0.1"},
    "observations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "sources", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^OBS-[A-Z0-9-]+$"},
          "sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^SRC-[A-Z0-9-]+$"}},
          "statement": {"type": "string", "minLength": 10}
        }
      }
    }
  }
}
