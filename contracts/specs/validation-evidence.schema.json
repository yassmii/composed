{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://composed-contract.org/schemas/validation-evidence/1.json",
  "title": "Declared contract validation observations",
  "required": [
    "format_version",
    "kind",
    "contract",
    "plan_sha256",
    "target",
    "verifier",
    "artifacts",
    "cases",
    "contradictions"
  ],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "contract-validation-evidence"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "version", "sha256"]
    },
    "plan_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": ["path", "sha256"]
          }
        }
      },
      "required": ["revision", "artifacts"]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["id"]
    },
    "artifacts": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": ["id", "path", "sha256"]
      }
    },
    "cases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "status": {
            "enum": ["pass", "fail", "blocked", "not_run"]
          },
          "method": {
            "enum": ["automated", "manual"]
          },
          "boundary": {
            "enum": [
              "artifact",
              "component",
              "integration",
              "public-interface",
              "human-review",
              "field-observation"
            ]
          },
          "kind": {
            "enum": ["positive", "negative", "malformed", "boundary", "concurrency", "recovery"]
          },
          "coverage": {
            "enum": ["complete", "partial", "unknown"]
          },
          "artifact_ids": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4096,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          },
          "limitations": {
            "type": "array",
            "minItems": 0,
            "maxItems": 4096,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            }
          },
          "review": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "author_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reviewer_id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "author_context": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "reviewer_context": {
                "type": "string",
                "minLength": 1,
                "maxLength": 256
              },
              "verdict": {
                "enum": ["accepted", "return_needed", "blocked"]
              }
            },
            "required": [
              "author_id",
              "reviewer_id",
              "author_context",
              "reviewer_context",
              "verdict"
            ]
          }
        },
        "required": [
          "case_id",
          "status",
          "method",
          "boundary",
          "kind",
          "coverage",
          "artifact_ids",
          "limitations"
        ]
      }
    },
    "contradictions": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "clause_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          },
          "artifact_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 4096,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 256
            },
            "uniqueItems": true
          },
          "detail": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "required": ["clause_ids", "artifact_ids", "detail"]
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["command", "exit_code", "started_at", "finished_at", "duration_ms", "runtime"],
      "properties": {
        "command": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 8192
          }
        },
        "exit_code": {
          "type": ["integer", "null"],
          "minimum": -2147483648,
          "maximum": 2147483647
        },
        "started_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64
        },
        "finished_at": {
          "type": "string",
          "minLength": 20,
          "maxLength": 64
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "duration_source": {
          "const": "monotonic"
        },
        "wall_clock_regressed": {
          "type": "boolean"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["platform"],
          "properties": {
            "platform": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "node": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            },
            "arch": {
              "type": "string",
              "minLength": 1,
              "maxLength": 8192
            }
          }
        }
      }
    }
  }
}
