{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "$id": "https://composed-contract.org/schemas/validation-plan/1.json",
  "title": "Scoped contract validation plan",
  "required": ["format_version", "kind", "contract", "scope", "verifier", "cases"],
  "properties": {
    "format_version": {
      "const": 1
    },
    "kind": {
      "const": "contract-validation-plan"
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        }
      },
      "required": ["id", "version", "sha256"]
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "clause_ids": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "uniqueItems": true
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      },
      "required": ["clause_ids", "description"]
    },
    "verifier": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "artifacts": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4096,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "path": {
                "type": "string",
                "minLength": 1,
                "maxLength": 1024
              },
              "sha256": {
                "type": "string",
                "pattern": "^[a-f0-9]{64}$"
              }
            },
            "required": ["path", "sha256"]
          }
        }
      },
      "required": ["id", "artifacts"]
    },
    "cases": {
      "type": "array",
      "minItems": 0,
      "maxItems": 4096,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "acceptance_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256
          },
          "method": {
            "enum": ["automated", "manual"]
          },
          "boundary": {
            "enum": [
              "artifact",
              "component",
              "integration",
              "public-interface",
              "human-review",
              "field-observation"
            ]
          },
          "kind": {
            "enum": ["positive", "negative", "malformed", "boundary", "concurrency", "recovery"]
          }
        },
        "required": ["id", "acceptance_id", "method", "boundary", "kind"]
      }
    }
  }
}
